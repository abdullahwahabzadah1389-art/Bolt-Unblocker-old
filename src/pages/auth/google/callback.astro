---
import Layout from "../../../Layouts/Layout.astro";
---

<Layout title="Completing sign-in" proxy={false}>
    <main
        style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.7rem;background:#0b0d12;color:#e6e8ee;font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;text-align:center;padding:2rem;"
    >
        <p id="bolt-auth-status" style="font-size:1.15rem;margin:0;">
            Completing sign-in…
        </p>
        <p
            id="bolt-auth-detail"
            style="color:#8b93a5;margin:0;font-size:.9rem;max-width:34rem;line-height:1.5;"
        >
        </p>
    </main>
    <script>
        import {
            deliverAuthReturn,
            injectProxyCookies,
            type ProxyCookie,
        } from "../../../scripts/auth-breakout";

        const status = document.getElementById("bolt-auth-status");
        const detail = document.getElementById("bolt-auth-detail");

        const show = (s: string, d: string) => {
            if (status) status.textContent = s;
            if (detail) detail.textContent = d;
        };

        const query = new URLSearchParams(window.location.search);
        const hash = new URLSearchParams(window.location.hash.slice(1));
        const pick = (key: string) => query.get(key) ?? hash.get(key);

        const payload = {
            code: pick("code") ?? undefined,
            state: pick("state") ?? undefined,
            error: pick("error") ?? undefined,
        };

        void (async () => {
            if (payload.error) {
                show("Sign-in failed", `Google returned: ${payload.error}`);
                deliverAuthReturn(payload);
                return;
            }

            if (!payload.code) {
                show(
                    "Nothing to complete",
                    "No authorization parameters were found in this URL.",
                );
                deliverAuthReturn(payload);
                return;
            }

            // The code is single-use and short-lived: keep it out of history so
            // a later visitor to the back button can't replay it.
            window.history.replaceState({}, "", window.location.pathname);

            let tokens: Record<string, unknown>;
            try {
                // Same-origin POST. The server does the actual call to Google
                // with client_secret — that secret never reaches this page.
                const res = await fetch("/api/auth/google/token", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "same-origin",
                    body: JSON.stringify({
                        code: payload.code,
                        state: payload.state,
                    }),
                });
                tokens = await res.json();
                if (!res.ok || tokens.error) {
                    const reason =
                        typeof tokens.error === "string"
                            ? tokens.error
                            : `HTTP ${res.status}`;
                    show("Token exchange failed", reason);
                    deliverAuthReturn(payload);
                    return;
                }
            } catch {
                show(
                    "Token exchange failed",
                    "Could not reach the exchange endpoint.",
                );
                deliverAuthReturn(payload);
                return;
            }

            // Step 3 — hand the verified token set to the proxy's cookie jar.
            //
            // Scramjet's worker only accepts `{ scramjet$type:"cookie", cookie,
            // url }` (it calls `setCookies([e.cookie], new URL(e.url))`), so the
            // flat {name, value} shape would throw on an undefined URL. The
            // helper serialises to Set-Cookie form and — critically — waits for
            // a controlling ServiceWorker (registering /sw.js first if the page
            // has none), so a message posted on first load is not dropped.
            const jar: ProxyCookie[] = [
                {
                    name: "G_AUTH_DATA",
                    value: JSON.stringify(tokens),
                    domain: ".google.com",
                    path: "/",
                    secure: true,
                },
            ];

            const injected = await injectProxyCookies(jar);

            show(
                "Sign-in complete",
                injected
                    ? `${injected} credential record written to the proxy jar. Note: this carries Google's OAuth tokens (access_token / id_token) for API use — Google does not issue its site session cookies (SID, __Secure-1PSID) to this flow, so google.com itself still renders signed out.`
                    : "No Service Worker controller was available, so the credential record was not written.",
            );

            deliverAuthReturn(payload);
        })();
    </script>
</Layout>
